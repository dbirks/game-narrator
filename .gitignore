*.zip
.env
.env.*
!.env.example
bin/
dist/
coverage/
artifacts/
node_modules/
web/dist/
# The staged Vite build is generated by `make build`, but the directory and its
# .keep placeholder must stay tracked so go:embed matches something on a fresh
# clone. The `dist/` pattern above would hide the directory whole, so it is
# re-included before its contents are ignored again.
!internal/webassets/dist/
internal/webassets/dist/*
!internal/webassets/dist/.keep
.playwright-cli/
playwright-report/
test-results/
verify-*.png
# Game images, savestates and input movies are never committed (AGENTS.md rule 5).
*.iso
*.gcm
*.rvz
*.ciso
*.7z
*.gcz
*.wbfs
*.wia
*.nkit.iso
*.dtm
*.sav
*.sqlite
*.sqlite-wal
*.sqlite-shm
/tmp/
/game-narrator

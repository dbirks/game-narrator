# Game Narrator — model provider configuration (M0).
#
# Copy to your own environment file or export these in a systemd unit.
# NEVER commit a real token or a real private endpoint hostname here
# (AGENTS.md rule 5). Every value below is a placeholder; `.invalid` hosts can
# never resolve, so a forgotten placeholder fails loudly instead of silently
# pointing at someone's server.
#
# Model *roles* are configured, not raw URLs (docs/spec/06 "Provider registry").
# A role is enabled only when its model is set; anything else reports
# NOT CONFIGURED in preflight and the service still runs in cached-only mode.

# --- Shared OpenAI-compatible gateway ---------------------------------------
# Base URL of the gateway that serves the chat roles. It may route several
# roles to different machines; do not assume one base URL serves every
# modality. Example only:
GAME_NARRATOR_GATEWAY_URL=https://gateway.example.invalid/v1

# Name of the environment variable that actually holds the bearer token.
# Point it at a variable you already export so the secret is never copied into
# a second file. Leave unset to use GAME_NARRATOR_GATEWAY_TOKEN.
GAME_NARRATOR_GATEWAY_TOKEN_ENV=GAME_NARRATOR_GATEWAY_TOKEN

# The token itself — only used when GAME_NARRATOR_GATEWAY_TOKEN_ENV is unset or
# names this variable. Real values belong outside the repository.
GAME_NARRATOR_GATEWAY_TOKEN=replace-with-real-secret-outside-git

# --- Role: agent_reasoning (onboarding agent tool loop) ---------------------
# Required to enable the role. Protocol default: openai_chat. Timeout default:
# 30s (docs/spec/06 "Timeout and cancellation defaults" — agent tasks).
GAME_NARRATOR_ROLE_AGENT_REASONING_MODEL=configure-me
# Optional per-role overrides. A role-specific _URL must not carry credentials
# in userinfo; the shared token variable is used either way.
#GAME_NARRATOR_ROLE_AGENT_REASONING_URL=https://agent-router.example.invalid/v1
#GAME_NARRATOR_ROLE_AGENT_REASONING_PROTOCOL=openai_chat
#GAME_NARRATOR_ROLE_AGENT_REASONING_TIMEOUT=30s

# --- Role: fast_reasoning (runtime classification / ranking) ----------------
# Protocol default: openai_chat. Timeout default: 10s.
GAME_NARRATOR_ROLE_FAST_REASONING_MODEL=configure-me
#GAME_NARRATOR_ROLE_FAST_REASONING_URL=https://fast-router.example.invalid/v1
#GAME_NARRATOR_ROLE_FAST_REASONING_PROTOCOL=openai_chat
#GAME_NARRATOR_ROLE_FAST_REASONING_TIMEOUT=10s

# --- Role: vision_ocr_fallback (multimodal textbox fallback) ----------------
# Protocol default: openai_chat_vision. Timeout default: 10s (VLM band is
# 3-10s). Images are sent as base64 data URLs, capped at 4 MB per image.
GAME_NARRATOR_ROLE_VISION_OCR_FALLBACK_MODEL=configure-me
#GAME_NARRATOR_ROLE_VISION_OCR_FALLBACK_URL=https://vision-router.example.invalid/v1
#GAME_NARRATOR_ROLE_VISION_OCR_FALLBACK_PROTOCOL=openai_chat_vision
#GAME_NARRATOR_ROLE_VISION_OCR_FALLBACK_TIMEOUT=10s

# --- decision (System One / Clef-Omni) --------------------------------------
# The decision role has an adapter (ADR-0021): with a model set, doctor probes
# the real /systemone route. _TIMEOUT is the runtime's per-call deadline
# (docs/spec/06); cold gateways can take longer, so the doctor probe runs on a
# 20 s budget. _URL is optional: unset means the shared gateway above. Each
# _URL must still be an http(s) endpoint without userinfo.
#GAME_NARRATOR_ROLE_DECISION_MODEL=clef-omni
#GAME_NARRATOR_ROLE_DECISION_URL=
#GAME_NARRATOR_ROLE_DECISION_PROTOCOL=systemone
#GAME_NARRATOR_ROLE_DECISION_TIMEOUT=1500ms

# --- Roles NOT DEPLOYED YET — leave these empty ------------------------------
# voice_design and voice_clone (vLLM-Omni TTS) and speech_asr (Qwen3-ASR) have
# no adapter implemented in this build. They are representable in configuration
# and report NOT CONFIGURED / NOT AVAILABLE; setting a model here does not make
# them work. ASR routes must be probed rather than assumed (docs/spec/06).

#GAME_NARRATOR_ROLE_VOICE_DESIGN_MODEL=
#GAME_NARRATOR_ROLE_VOICE_DESIGN_URL=
#GAME_NARRATOR_ROLE_VOICE_DESIGN_PROTOCOL=vllm_omni_speech
#GAME_NARRATOR_ROLE_VOICE_DESIGN_TIMEOUT=120s

#GAME_NARRATOR_ROLE_VOICE_CLONE_MODEL=
#GAME_NARRATOR_ROLE_VOICE_CLONE_URL=
#GAME_NARRATOR_ROLE_VOICE_CLONE_PROTOCOL=vllm_omni_speech
#GAME_NARRATOR_ROLE_VOICE_CLONE_TIMEOUT=120s

#GAME_NARRATOR_ROLE_SPEECH_ASR_MODEL=
#GAME_NARRATOR_ROLE_SPEECH_ASR_URL=
#GAME_NARRATOR_ROLE_SPEECH_ASR_PROTOCOL=probe_required
#GAME_NARRATOR_ROLE_SPEECH_ASR_TIMEOUT=30s

# --- Live provider contract tests only (docs/spec/12 "Contract" mode) -------
# Model id the live tests probe against GAME_NARRATOR_GATEWAY_URL. Defaults to
# qwen3-8-flash-next. The tests SKIP with "NOT RUN: ..." when the gateway URL or
# token is absent, so `go test ./...` stays green offline.
GAME_NARRATOR_LIVE_MODEL=qwen3-8-flash-next
